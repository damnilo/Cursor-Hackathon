# Copy to .env.local for Next.js. Never commit real values.
# `npx convex dev` writes NEXT_PUBLIC_CONVEX_URL (and CONVEX_DEPLOYMENT) for you.

# Required (Next.js, build time)
NEXT_PUBLIC_CONVEX_URL=

# ---------------------------------------------------------------
# The variables below are read by Convex functions. Set them in the
# Convex dashboard (or `npx convex env set NAME value`), not in .env.local.
# ---------------------------------------------------------------

# Auth (required for Google sign-in)
# SITE_URL=http://localhost:3000
# JWT_PRIVATE_KEY=
# JWKS=
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# Optional external APIs
# GITHUB_TOKEN=
# FIRECRAWL_API_KEY=
# EXA_API_KEY=
# XAI_API_KEY=   # Grok client, currently not called
