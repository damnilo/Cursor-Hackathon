# Copy to .env.local. Never commit real values.
# Local Convex: `npx convex dev` writes NEXT_PUBLIC_CONVEX_URL for you.

# Phase 1 — required for the app
NEXT_PUBLIC_CONVEX_URL=

# Phase 3 — set in Convex dashboard (not Next.js)
# XAI_API_KEY=
# FIRECRAWL_API_KEY=
# GITHUB_TOKEN=
# EXA_API_KEY=

# Google sign-in — Convex dashboard (not Next.js)
# SITE_URL=http://localhost:3000
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# JWT_PRIVATE_KEY=
# JWKS=
